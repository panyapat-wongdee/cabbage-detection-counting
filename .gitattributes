# Run evidence records the SHA-256 of text artifacts such as the split
# manifest, so a checkout must produce identical bytes on every platform.
# Without this, a Windows checkout converts LF to CRLF and the same file hashes
# differently than it did on the machine that produced the run.
* text=auto eol=lf
# Python's csv module ends rows with CRLF on every platform, and each run's
# metadata records the SHA-256 of that training log, so it is stored unchanged.
**/logs/training_log.csv -text whitespace=cr-at-eol

*.png binary
# Generated by scripts/make_figures.py; never hand-edited or diffed.
*.svg binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.pt binary
*.pth binary
*.onnx binary
*.safetensors binary
